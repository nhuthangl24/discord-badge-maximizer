# Discord Badge Maximizer - Configuration Template
# Copy this file to .env:
# cp .env.example .env

# ==========================================
# 1. DISCORD APPLICATION BOT TOKEN (Required if running bot.py)
# ==========================================
# Create a bot at https://discord.com/developers/applications
# Copy its Token and paste here:
DISCORD_BOT_TOKEN=

# ==========================================
# 2. ALT ACCOUNT USER CREDENTIALS
# ==========================================
# Note: You can also set these directly inside Discord via /set_token
DISCORD_TOKEN=
DISCORD_COOKIE=
DISCORD_VIEWER_TOKEN=

# ==========================================
# 3. DEFAULT VOICE CHANNEL & GUILD
# ==========================================
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
